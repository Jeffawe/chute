[Unit]
Description=Periodic sweep of the shared Taildrop folder

# Backstop for the path unit: a file that was still being written when the
# watch fired is skipped, and without this nothing would pick it up again.
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=chute-fanout.service

[Install]
WantedBy=timers.target
