#!/usr/bin/env bash
# Copy new arrivals from the shared Taildrop folder into this user's own
# folder. Runs as the user, so copies are owned by them from the start.
#
# This is deliberately a pull, not a push: each user opts in by enabling their
# own systemd unit, and nothing runs as root.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/chute-fanout.conf"
# shellcheck disable=SC1090
[[ -r "$CONF" ]] && . "$CONF"

SRC="${CHUTE_SHARED_DIR:-/home/taildrop}"
DEST="${CHUTE_USER_DIR:-$HOME/Downloads}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/chute-fanout/seen"

[[ -d "$SRC" ]] || { echo "shared folder missing: $SRC" >&2; exit 0; }
mkdir -p "$DEST" "$STATE"

# Markers are hashed, so filenames containing anything at all are safe.
marker_for() { printf '%s' "$1" | sha256sum | cut -c1-40; }

shopt -s nullglob dotglob
copied=0
for f in "$SRC"/*; do
  [[ -f "$f" ]] || continue
  name="$(basename -- "$f")"
  marker="$STATE/$(marker_for "$name")"

  # Already handled. Deleting your copy is respected: it stays gone.
  [[ -e "$marker" ]] && continue

  # The receiver may still be writing. If the size is not yet stable, leave it
  # for the next trigger or the periodic sweep rather than copying a fragment.
  size1=$(stat -c%s -- "$f" 2>/dev/null) || continue
  sleep 1
  size2=$(stat -c%s -- "$f" 2>/dev/null) || continue
  [[ "$size1" == "$size2" ]] || continue

  # --reflink=auto is free on btrfs and degrades to a real copy elsewhere.
  # -n so an existing file of the same name is never clobbered.
  if cp --reflink=auto -n -- "$f" "$DEST/$name" 2>/dev/null; then
    : > "$marker"
    copied=$((copied + 1))
    echo "copied: $name"
  else
    echo "could not copy: $name" >&2
  fi
done

[[ $copied -gt 0 ]] && echo "$copied file(s) -> $DEST"
exit 0
